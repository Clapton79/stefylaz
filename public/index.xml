			<item>
				<title>About Us</title>
				<link>http://localhost:1313/about/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/about/</guid>
				<description>&lt;h3 id=&#34;our-story&#34;&gt;Our Story&lt;/h3&gt;&#xA;&lt;p&gt;This is a draft for our story. We’ll fill in how our journey began, the moments that brought us here, and why Budapest became the place we chose to celebrate. For now, we’re simply looking forward to sharing the day with you.&lt;/p&gt;&#xA;&lt;figure class=&#34;story-photo&#34;&gt;&#xA;&lt;img src=&#34;http://localhost:1313/images/StefLazCouch.jpg&#34; alt=&#34;Stef and Laz relaxing together on a couch&#34;&gt;&#xA;&lt;/figure&gt;</description>
			</item>
			<item>
				<title>Contacts</title>
				<link>http://localhost:1313/contact/</link>
				<pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
				<guid>http://localhost:1313/contact/</guid>
				<description>&lt;section class=&#34;contact-section&#34;&gt;&#xA;&lt;h3&gt;Questions?&lt;/h3&gt;&#xA;&lt;p&gt;Do you have a question about the wedding? Email us at &lt;a href=&#34;mailto:stef.laz.wedding@gmail.com&#34;&gt;stef.laz.wedding@gmail.com&lt;/a&gt;.&lt;/p&gt;&#xA;&lt;/section&gt;&#xA;&lt;section class=&#34;contact-section&#34;&gt;&#xA;&lt;h3&gt;Share your photos&lt;/h3&gt;&#xA;&lt;p&gt;If you take photos at the venue, you can send them to us using the form below. We won’t share them; we’ll keep them as memories of this special day.&lt;/p&gt;&#xA;&lt;span class=&#34;pending-link&#34;&gt;Google Forms — upload link coming soon&lt;/span&gt;&#xA;&lt;/section&gt;</description>
